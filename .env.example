# ============================================================
# Aegis Investor Suite — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# --- Supabase ---
# Found at: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Stripe ---
# Found at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# The Price ID of your R$19,90/month product in Stripe
# Create it at: https://dashboard.stripe.com/products
STRIPE_PRICE_ID=price_...

# Stripe webhook secret (from: stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
